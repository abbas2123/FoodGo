DATABASE_URL="postgresql://user:password@localhost:5432/foodgo"
NODE_ENV="development"
PORT=3000
# Number of trusted reverse-proxy hops in front of this server.
# 0 = disabled (default, safe for direct connections and local dev).
# 1 = one proxy (nginx / ALB / Railway / Render / Fly.io).
# Set to the exact hop count in your deployment topology.
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET="your-super-secret-access-token-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Authentication Provider: 'email' (primary/default) or 'sms' (legacy)
AUTH_PROVIDER="email"

# Email Provider Configuration: 'dev' for local console output, 'smtp' for Gmail SMTP, 'resend' for Resend API
EMAIL_PROVIDER="dev"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="FoodiGo <your-email@gmail.com>"

# Gmail SMTP Configuration (used when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"

# Legacy SMS Provider Configuration (required in production only if AUTH_PROVIDER="sms"):
SMS_PROVIDER="dev"
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_PHONE="+1234567890"

# CORS configuration (Required in production: comma-separated list of origins, wildcard '*' forbidden)
# Example: CORS_ORIGIN="https://app.foodigo.app,https://admin.foodigo.app"
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# Payment Gateway Configuration (Required in production, mock keys strictly forbidden)
# Canonical names are PAYMENT_* (RAZORPAY_* accepted as legacy aliases)
PAYMENT_KEY_ID="rzp_test_your_key_id"
PAYMENT_KEY_SECRET="your_payment_key_secret"
PAYMENT_WEBHOOK_SECRET="your_webhook_hmac_secret"
