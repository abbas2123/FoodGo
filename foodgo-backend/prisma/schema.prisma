// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native"                      — resolves to the current platform binary (macOS for local dev)
  // "linux-musl-openssl-3.0.x"   — Alpine Linux (musl libc) for Docker/staging
  // "linux-arm64-openssl-3.0.x"  — Alpine on ARM64 (uncomment if deploying to ARM hosts)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {

  ACTIVE

  INACTIVE

  SUSPENDED

  DELETED

}

enum UserType {

  CUSTOMER

  RESTAURANT_USER

  DRIVER

  ADMIN

}

model User {

  id              BigInt     @id @default(autoincrement())

  type            UserType

  name            String?    @db.VarChar(150)

  email           String?    @unique @db.VarChar(255)

  profileImageUrl String?    @map("profile_image_url") @db.VarChar(500)

  status          UserStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  auth          UserAuth?

  refreshTokens RefreshToken[]

  paymentMethods UserPaymentMethod[]

  notifications Notification[]

  searchHistories SearchHistory[]

  orderStatusChanges OrderStatusHistory[]

  paymentTransactions PaymentTransaction[]

  @@index([status])

  @@map("users")

}

model UserAuth {

  id       BigInt @id @default(autoincrement())

  userId   BigInt @unique @map("user_id")

  phone         String? @unique @db.VarChar(20)

  phoneVerified Boolean @default(false) @map("phone_verified")

  email         String? @unique @db.VarChar(255)

  emailVerified Boolean @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])

  @@index([email])

  @@map("user_auth")

}

model OtpVerification {

  id       BigInt @id @default(autoincrement())

  phone    String? @db.VarChar(20)

  email    String? @db.VarChar(255)

  purpose  String @db.VarChar(50)

  otpHash    String    @map("otp_hash") @db.VarChar(255)

  attempts   Int       @default(0)

  maxAttempts Int      @default(5) @map("max_attempts")

  expiresAt  DateTime  @map("expires_at")

  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])

  @@index([email])

  @@index([purpose])

  @@index([expiresAt])

  @@index([phone, purpose])

  @@index([email, purpose])

  @@map("otp_verifications")

}

model RefreshToken {

  id        BigInt @id @default(autoincrement())

  userId    BigInt @map("user_id")

  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("refresh_tokens")

}

enum PaymentMethodType {
  UPI
  CARD
  COD
  WALLET
  NET_BANKING
}

model UserPaymentMethod {
  id                 BigInt            @id @default(autoincrement())
  userId             BigInt            @map("user_id")
  type               PaymentMethodType
  provider           String?           @db.VarChar(50)
  providerCustomerId String?           @map("provider_customer_id") @db.VarChar(255)
  maskedIdentifier   String            @map("masked_identifier") @db.VarChar(100)
  isDefault          Boolean           @default(false) @map("is_default")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_payment_methods")
}

// ─── Payment Transactions ─────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  COD
  WALLET
}

model PaymentTransaction {
  id                BigInt          @id @default(autoincrement())
  orderId           Int             @map("order_id")
  userId            BigInt          @map("user_id")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?         @unique @map("provider_order_id") @db.VarChar(100)
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(100)
  providerSignature String?         @map("provider_signature") @db.VarChar(255)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR") @db.VarChar(5)
  status            PaymentStatus   @default(CREATED)
  method            String?         @db.VarChar(50)
  failureCode       String?         @map("failure_code") @db.VarChar(100)
  failureMessage    String?         @map("failure_message") @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  paidAt            DateTime?       @map("paid_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model ProcessedWebhookEvent {
  id          BigInt          @id @default(autoincrement())
  provider    PaymentProvider @default(RAZORPAY)
  eventId     String          @map("event_id") @db.VarChar(100)
  eventType   String          @map("event_type") @db.VarChar(100)
  processedAt DateTime        @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

model addresses {
  id            BigInt   @id @default(autoincrement())
  user_id       BigInt   @map("user_Id")

  label         String   @db.VarChar(50)
  address_line1 String   @db.VarChar(255)
  address_line2 String   @db.VarChar(255)
  landmark      String   @db.VarChar(255)

  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postal_code   String   @db.VarChar(20)
  country       String   @db.VarChar(100)

  latitude      Decimal  @db.Decimal(10, 7)
  longitude     Decimal  @db.Decimal(10, 7)

  is_default    Boolean

  created_at    DateTime
  updated_at    DateTime

  orders        Order[]

  @@index([user_id])
}

// ─── Food Categories ───────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  emoji     String   @db.VarChar(10)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

// ─── Restaurants ───────────────────────────────────────────────────────────────

model Restaurant {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(150)
  cuisineTypes    String   @map("cuisine_types") @db.VarChar(255)
  rating          Decimal  @default(0) @db.Decimal(3, 1)
  reviewCount     String   @default("0") @map("review_count") @db.VarChar(20)
  deliveryTimeMin Int      @default(15) @map("delivery_time_min")
  deliveryTimeMax Int      @default(30) @map("delivery_time_max")
  deliveryFee     Decimal  @default(0) @db.Decimal(8, 2) @map("delivery_fee")
  isFreeDelivery  Boolean  @default(false) @map("is_free_delivery")
  imageUrl        String   @db.VarChar(500) @map("image_url")
  isOpen          Boolean  @default(true) @map("is_open")
  offerText       String?  @db.VarChar(255) @map("offer_text")
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menuItems MenuItem[]
  orders    Order[]
  favorites Favorite[]
  reviews   Review[]

  @@map("restaurants")
}

// ─── Menu Items ────────────────────────────────────────────────────────────────

model MenuItem {
  id           Int     @id @default(autoincrement())
  restaurantId Int     @map("restaurant_id")
  categoryName String  @map("category_name") @db.VarChar(100)
  name         String  @db.VarChar(150)
  description  String  @db.VarChar(500)
  price        Decimal @db.Decimal(10, 2)
  imageUrl     String  @db.VarChar(500) @map("image_url")
  rating       Decimal @default(0) @db.Decimal(3, 1)
  isVeg        Boolean @default(false) @map("is_veg")
  isBestseller Boolean @default(false) @map("is_bestseller")
  isAvailable  Boolean @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([restaurantId])
  @@map("menu_items")
}

// ─── Orders ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique @map("order_number") @db.VarChar(20)
  userId         BigInt      @map("user_id")
  restaurantId   Int         @map("restaurant_id")
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(10, 2) @map("tax_amount")
  deliveryFee    Decimal     @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  grandTotal     Decimal     @db.Decimal(10, 2) @map("grand_total")
  currencySymbol String      @default("₹") @map("currency_symbol") @db.VarChar(5)
  addressId      BigInt?     @map("address_id")

  deliveryAddressText String?  @map("delivery_address_text") @db.VarChar(500)
  paymentMethod       String?  @map("payment_method") @db.VarChar(50)
  paymentStatus       String   @default("PENDING") @map("payment_status") @db.VarChar(50)
  driverId            String?  @map("driver_id") @db.VarChar(50)
  driverName          String?  @map("driver_name") @db.VarChar(100)
  driverPhone         String?  @map("driver_phone") @db.VarChar(20)
  driverRating        Decimal? @map("driver_rating") @db.Decimal(3, 1)
  driverLat           Decimal?  @map("driver_lat") @db.Decimal(10, 7)
  driverLng           Decimal?  @map("driver_lng") @db.Decimal(10, 7)
  driverHeading       Int?      @map("driver_heading")
  driverUpdatedAt     DateTime? @map("driver_updated_at")

  specialInstructions String?   @db.VarChar(500) @map("special_instructions")
  checkoutGroupId     String? @map("checkout_group_id") @db.VarChar(50)

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  completedAt      DateTime? @map("completed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  preparingAt      DateTime? @map("preparing_at")
  outForDeliveryAt DateTime? @map("out_for_delivery_at")
  deliveredAt      DateTime? @map("delivered_at")
  cancelledAt      DateTime? @map("cancelled_at")

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  address       addresses?           @relation(fields: [addressId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items         OrderItem[]
  review        Review?
  notifications Notification[]
  statusHistory OrderStatusHistory[]
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([status, createdAt])
  @@index([restaurantId])
  @@index([checkoutGroupId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  menuItemId   Int?    @map("menu_item_id")
  name         String  @db.VarChar(150)
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  imageUrl     String? @db.VarChar(500) @map("image_url")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─── Favorites ─────────────────────────────────────────────────────────────────

model Favorite {
  id           Int        @id @default(autoincrement())
  userId       BigInt     @map("user_id")
  restaurantId Int        @map("restaurant_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@map("favorites")
}

// ─── Reviews ───────────────────────────────────────────────────────────────────

model Review {
  id           Int        @id @default(autoincrement())
  userId       BigInt     @map("user_id")
  orderId      Int        @unique @map("order_id")
  restaurantId Int        @map("restaurant_id")
  rating       Int
  comment      String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("reviews")
}

// ─── Cart ──────────────────────────────────────────────────────────────────────

model Cart {
  id           Int        @id @default(autoincrement())
  userId       BigInt     @unique @map("user_id")
  restaurantId Int?       @map("restaurant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id                  Int      @id @default(autoincrement())
  cartId              Int      @map("cart_id")
  menuItemId          Int      @map("menu_item_id")
  quantity            Int      @default(1)
  specialInstructions String?  @map("special_instructions") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, menuItemId])
  @@index([cartId])
  @@map("cart_items")
}

// ─── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(200)
  message   String   @db.VarChar(500)
  type      String   @default("ORDER_UPDATE") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  orderId   Int?     @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Search History ───────────────────────────────────────────────────────────

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  query     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId])
  @@map("search_history")
}

// ─── Order Status History ─────────────────────────────────────────────────────

model OrderStatusHistory {
  id              BigInt       @id @default(autoincrement())
  orderId         Int          @map("order_id")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId BigInt?      @map("changed_by_user_id")
  reason          String?      @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}